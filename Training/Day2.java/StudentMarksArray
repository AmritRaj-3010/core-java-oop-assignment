public class StudentMarksArray{
    public static void main(String[] args){
        //step 1: create an array to store marks of 10 students
        int[]marks ={78,85,92,67,88,86,84,78,97,65};
        //step 2 : print heading
        System.out.println("Student Marks:");
        //step 3 : use loop to access each element of loop
        for (int i = 0; i < marks.length; i++){
            System.out.println("Student " + (i + 1) + "Marks = " + marks[i]);

        }
    }
}