//wap in java in which we create employee objects with shared company name using static variable
//instance variable
public class EmployeeStaticDemo {
    //step 1: declare employee details and static variable for company name
    int empId;
    String empName;
    static String companyName = "ABC Corporation";

    // step 2: create constructor to initialize employee details
    EmployeeStaticDemo(int id, String name) {
        empId = id;
        empName = name;
    }
    //step 3: create method to display employee details along with company name
    void display() {
        System.out.println("Employee ID: " + empId);
        System.out.println("Employee Name: " + empName);
        System.out.println("Company Name: " + companyName);
        System.out.println("----------------------------");
    }
    //step 4: create main method to create employee objects and display their details
    public static void main(String[] args) {
        EmployeeStaticDemo e1 = new EmployeeStaticDemo(101, "Amit");
        EmployeeStaticDemo e2 = new EmployeeStaticDemo(102, "Riya");
        //step 5: display employee details
        e1.display();
        e2.display();
    }
}