//wap in java to find factorial of a number 
import java.util.Scanner;
public class factorial_of_2_number {
    //step 1: create a method to find factorial of a number
    public static void main(String[] args) {
        //step 2: create a variable to enter a number
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter a number: ");
        //step 3: perform operations to find factorial of a number
        int num = sc.nextInt();
        int factorial = 1;
        //step 4: display result
        for (int i = 1; i <= num; i++) {
            factorial *= i;
        }
        System.out.println("Factorial of " + num + " is: " + factorial);
        sc.close();
    }
}