/*Takes array size as input
Reads elements into the array
Prints all elements
Calculates the sum
Finds the largest element */

import java.util.Scanner;
//wap in java to find factorial of a number
class ArrayDemo {
    //step 1: create a method to find factorial of a number
    public static void main(String[] args) {
        int n, sum = 0;
        //step 2: create a variable to enter a number
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter size of array: ");
        //step 3: perform operations to find factorial of a number
        n = sc.nextInt();
        //step 4: display result
        if (n <= 0) {
            System.out.println("Array size must be greater than 0");
            return;
        }
        //step 5: create an array to store elements
        int arr[] = new int[n];

        // Input
        System.out.println("Enter elements:");
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        // Display + Sum
        System.out.println("Array elements are:");
        for (int i = 0; i < n; i++) {
            System.out.print(arr[i] + " ");
            sum += arr[i];
        }

        System.out.println("\nSum of elements = " + sum);

        // Largest element
        int max = arr[0];
        for (int i = 1; i < n; i++) {
            if (arr[i] > max) {
                max = arr[i];
            }
        }

        System.out.println("Largest element = " + max);

        sc.close(); 
    }
}