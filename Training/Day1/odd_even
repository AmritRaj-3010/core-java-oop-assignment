//WAP in java to check whether a number is odd or even


import java.util.Scanner;
//step 1: create a method to check whether a number is odd or even
public class OddEven{
    //step 2: create a variable to enter a number
    public static void main(String[] args){
        //step 3: perform operations to check whether a number is odd or even
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter a number: ");
        //step 4: display result
        int num = sc.nextInt();
        if (num%2==0){
            System.out.println(num+"is even.");
        }else{
            System.out.println(num+"is odd.");
        }
        sc.close();
    }
}