//WAP in java to find sum of two numbers
//step 1: create a method to find factorial of a number
import java.util.Scanner;
//step 2: create a variable to enter a number
class Main {
    //step 3: perform operations to find factorial of a number
    public static void main(String[] args) {
        //create a variable to enter two value
        //perform operations
        //step 4: display result
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter two numbers");
        //step 5: create variables to store the two numbers
        double a = sc.nextDouble();
        double b = sc.nextDouble();
        //step 6: perform addition and display result
        System.out.println("Sum: "+ (a+b));
        sc.close();
    }
}