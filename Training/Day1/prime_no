//wap to check whether a number is prime or not
import java.util.Scanner;
public class prime_no {
    //step 1: create a method to check whether a number is prime or not
    public static void main(String[] args) {
        //step 2: create a variable to enter a number
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter a number: ");
        //step 3: perform operations to check whether a number is prime or not
        int num = sc.nextInt();
        boolean isPrime = true;
        //step 4: check if the number is prime
        if (num <= 1) {
            isPrime = false;
        } else {
            for (int i = 2; i <= num / 2; i++) {
                if (num % i == 0) {
                    isPrime = false;
                    break;
                }
            }
        }
        //step 5: display result
        if (isPrime) {
            System.out.println(num + " is a prime number.");
        } else {
            System.out.println(num + " is not a prime number.");
        }
        sc.close();
    }
}